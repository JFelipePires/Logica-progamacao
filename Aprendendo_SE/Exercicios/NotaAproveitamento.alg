algoritmo "Notas Aproveitamento"
var
N1, N2, Media: Real
inicio
    Escreval ("---------------------------")
    Escreval ("   Escola do Perna Manca   ")
    Escreval ("---------------------------")
    Escreva ("Digite a primeira nota: ")
    Leia (N1)
    Escreval ("Digite a segunda nota: ")
    Leia (N2)
    Media <- (N1 + N2) / 2
    Escreva



fimalgoritmo 
