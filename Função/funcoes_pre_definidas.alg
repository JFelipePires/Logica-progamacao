algoritmo "funcoes_predef"

var
    N: caractere
inicio
    escreva ("Digite o seu nome: ")
    leia (N) 
    escreval ("Total de letras no seu nome: ", compr)
    escreval ("Seu nome em maisculo: ", maiusc)
    escreval ("Seu nome em minusculo: ", minusc)
    escreval ("A primeira letra do seu nome é: ", copia (N, 1, 1))
fimalgoritmo